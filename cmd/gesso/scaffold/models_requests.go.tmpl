package models

import (
{{- if .UsesTime}}
	"time"
{{end}}
	"github.com/Elagoht/gesso"
{{- if .UsesDate}}
	"github.com/Elagoht/gesso/date"
{{- end}}
)

// ReqCreate{{.Entity}} is the body that creates a {{.Entity}}.
type ReqCreate{{.Entity}} struct {
{{- range .Fields}}
	{{.Go}} {{.Type}} `json:"{{.JSON}}"{{if .Rule}} validate:"{{.Rule}}"{{end}}`
{{- end}}
}

// ReqUpdate{{.Entity}} replaces a {{.Entity}}: its id from the path, everything
// else from the body.
type ReqUpdate{{.Entity}} struct {
	ID int64 `path:"id"`
{{- range .Fields}}
	{{.Go}} {{.Type}} `json:"{{.JSON}}"{{if .Rule}} validate:"{{.Rule}}"{{end}}`
{{- end}}
}

// ReqPatch{{.Entity}} changes some of a {{.Entity}}: a field left out stays as it is.
type ReqPatch{{.Entity}} struct {
	ID int64 `path:"id"`
{{- range .Fields}}
	{{.Go}} gesso.Optional[{{.Type}}] `json:"{{.JSON}},omitzero" validate:"{{.Patch}}"`
{{- end}}
}

// Req{{.Entity}}ID names one {{.Entity}} by its id.
type Req{{.Entity}}ID struct {
	ID int64 `path:"id"`
}

// ReqList{{.Plural}} pages through the {{.Table}}: After is the Next of the page before.
type ReqList{{.Plural}} struct {
	After string `query:"after"`
	Take  int    `query:"take" default:"20" validate:"min=1,max=100"`
}
