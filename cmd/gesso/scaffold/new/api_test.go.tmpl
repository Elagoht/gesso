package api

import (
	"context"
	"log/slog"
	"net/http/httptest"
{{- if eq .Dialect "sqlite"}}
	"path/filepath"
{{- else}}
	"os"
{{- end}}
	"testing"
)

func testDatabase(t *testing.T) string {
{{- if eq .Dialect "sqlite"}}
	return filepath.Join(t.TempDir(), "test.db")
{{- else}}
	dsn := os.Getenv("TEST_DATABASE_URL")
	if dsn == "" {
		t.Skip("TEST_DATABASE_URL is not set")
	}
	return dsn
{{- end}}
}

func TestNew(t *testing.T) {
	a, err := NewWith(Config{Database: testDatabase(t), Logger: slog.New(slog.DiscardHandler)})
	if err != nil {
		t.Fatal(err)
	}
	if err := a.Start(context.Background()); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = a.Shutdown(context.Background()) })
	for _, path := range []string{"/openapi.json", "/healthz", "/readyz"} {
		rec := httptest.NewRecorder()
		a.ServeHTTP(rec, httptest.NewRequest("GET", path, nil))
		if rec.Code != 200 {
			t.Fatalf("GET %s: %d %s", path, rec.Code, rec.Body)
		}
	}
}

func TestNewWantsADatabase(t *testing.T) {
	if _, err := NewWith(Config{}); err == nil {
		t.Fatal("an empty Database is refused")
	}
}
