package api

import (
	"context"
	"log/slog"
	"net/http/httptest"
{{- if eq .Dialect "sqlite"}}
	"path/filepath"
{{- else}}
	"os"
{{- end}}
	"testing"
)

// testDatabase is the database the tests run on.
func testDatabase(t *testing.T) string {
{{- if eq .Dialect "sqlite"}}
	return filepath.Join(t.TempDir(), "test.db")
{{- else}}
	dsn := os.Getenv("TEST_DATABASE_URL")
	if dsn == "" {
		t.Skip("TEST_DATABASE_URL is not set: the app needs a {{.DialectName}} database to test against")
	}
	return dsn
{{- end}}
}

// The API starts on an empty database — its migrations run — and answers.
func TestNew(t *testing.T) {
	a, err := New(context.Background(), Config{Database: testDatabase(t), Logger: slog.New(slog.DiscardHandler)})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := a.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	rec := httptest.NewRecorder()
	a.ServeHTTP(rec, httptest.NewRequest("GET", "/openapi.json", nil))
	if rec.Code != 200 {
		t.Fatalf("GET /openapi.json: %d %s", rec.Code, rec.Body)
	}
}

func TestNewWantsADatabase(t *testing.T) {
	if _, err := New(context.Background(), Config{}); err == nil {
		t.Fatal("an empty Database is refused, not opened as a database of its own")
	}
}
