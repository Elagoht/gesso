// Package api builds the API from its configuration: the database, the modules'
// migrations, the modules, and the mapping from database errors to answers.
// Scaffolded by gesso new; it is yours now. gesso add module adds each new
// module to modules and migrations below; gesso add auth adds sign-in.
package api

import (
	"cmp"
	"context"
	"database/sql"
	"errors"
	"io"
	"io/fs"
	"log/slog"
	"os"

	"github.com/Elagoht/gesso"
	"github.com/Elagoht/gesso/db"
	"github.com/Elagoht/gesso/migrate"
{{- if eq .Dialect "sqlite"}}
	"modernc.org/sqlite"
{{- else if eq .Dialect "postgres"}}
	"github.com/jackc/pgx/v5/pgconn"
	_ "github.com/jackc/pgx/v5/stdlib"
{{- else}}
	"github.com/go-sql-driver/mysql"
{{- end}}
)

// Config is what the app takes from its environment.
type Config struct {
	Addr     string // where Run listens: ":8080"
	BasePath string // "/api" when collage mounts the app at /api/; "" on its own
	Database string // {{.DSNDoc}}
	Logger   *slog.Logger
}

// Deps is what the modules are built from.
type Deps struct {
	DB db.DB
}

// modules are the application's features, in order.
func modules(d Deps) []gesso.Module {
	return []gesso.Module{}
}

// migrations are the modules' migrations, applied as one history: their
// timestamped versions sort across modules.
func migrations() []fs.FS {
	return []fs.FS{}
}

// stores make gesso's own tables — sign-in tokens, a queue — after the
// modules' migrations, each in a history of its own: token.Migrate,
// queue.Migrate.
func stores() []func(context.Context, *sql.DB, migrate.Dialect) error {
	return []func(context.Context, *sql.DB, migrate.Dialect) error{}
}

// constraints name the field each database constraint guards, so that a
// violation is answered as that field's error: {{.ConstraintExample}}.
var constraints = map[string]string{}

// dialect is the SQL the migrations and the repositories are written in.
var dialect = migrate.{{.DialectGo}}

// New builds the API from the environment gesso.Main read:
//
//	DATABASE_URL  {{.DSNDoc}} (default {{.DefaultDSN}})
//	BASE_PATH     the prefix every route is under: "/api" behind a proxy that
//	              passes the full path on
func New(env gesso.Env) (*gesso.App, error) {
	return NewWith(Config{
		Addr:     env.Addr,
		BasePath: os.Getenv("BASE_PATH"),
		Database: cmp.Or(os.Getenv("DATABASE_URL"), "{{.DefaultDSN}}"),
		Logger:   env.Logger,
	})
}

// NewWith builds the API from cfg: a collage site, or a test, gives one of
// its own. The database's migrations run when the app starts — Run, or
// collage-gesso when collage serves — and it closes when the app shuts down.
func NewWith(cfg Config) (*gesso.App, error) {
	if cfg.Database == "" {
		return nil, errors.New("api: Config.Database is empty: name the database")
	}
	d, err := open(cfg.Database)
	if err != nil {
		return nil, err
	}
	app, err := gesso.New(gesso.Config{
		Addr:         cfg.Addr,
		BasePath:     cfg.BasePath,
		Logger:       cfg.Logger,
		ErrorMappers: []gesso.ErrorMapper{db.Errors(classify, constraints)},
		// The OpenAPI document maps every route, to anyone who asks: guard it, or
		// leave Path empty to only generate it, before the API is public.
		OpenAPI:   &gesso.OpenAPIConfig{Title: "{{.Name}}", Version: "0.1.0", Path: "/openapi.json"},
		AccessLog: true,
		// /healthz answers while the process runs; /readyz while the database
		// does too, and turns 503 when the app begins to stop.
		Health: &gesso.Health{Checks: map[string]func(context.Context) error{"database": d.PingContext}},
	}, append([]gesso.Module{schema{dsn: cfg.Database}}, modules(Deps{DB: d})...)...)
	if err != nil {
		return nil, errors.Join(err, d.Close())
	}
	app.OnShutdown(func(context.Context) error { return d.Close() })
	app.Command("migrate", func(ctx context.Context, args []string, out io.Writer) error {
		m, conn, err := migrator(cfg.Database)
		if err != nil {
			return err
		}
		return errors.Join(migrate.Command(ctx, m, args, out), conn.Close())
	})
	return app, nil
}

// schema brings the database up to date as the app starts, before it serves:
// the modules' migrations, then the stores'.
type schema struct{ dsn string }

func (schema) Routes(*gesso.Router) {}

func (s schema) Start(ctx context.Context) error {
	m, conn, err := migrator(s.dsn)
	if err != nil {
		return err
	}
	if _, err := m.Up(ctx); err != nil {
		return errors.Join(err, conn.Close())
	}
	for _, store := range stores() {
		if err := store(ctx, conn, dialect); err != nil {
			return errors.Join(err, conn.Close())
		}
	}
	return conn.Close()
}

// migrator is the app's migrations on the database at dsn, and the
// connection it opened for them{{if eq .Dialect "mysql"}} — one of its own, which takes several statements in
// one Exec; the app's pool does not, so an injected "; DROP" is never a second
// statement{{end}}.
func migrator(dsn string) (*migrate.Migrator, *sql.DB, error) {
{{- if eq .Dialect "mysql"}}
	d, err := openMigrator(dsn)
{{- else}}
	d, err := open(dsn)
{{- end}}
	if err != nil {
		return nil, nil, err
	}
	m, err := migrate.New(d, dialect, migrations()...)
	if err != nil {
		return nil, nil, errors.Join(err, d.Close())
	}
	return m, d, nil
}
{{if eq .Dialect "sqlite"}}
// open opens the SQLite file at path: foreign keys enforced, readers beside
// the one writer (WAL), and a writer that waits for the lock instead of failing.
func open(path string) (*sql.DB, error) {
	return sql.Open("sqlite", "file:"+path+"?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)")
}

func classify(err error) (db.Violation, bool) {
	var se *sqlite.Error
	if !errors.As(err, &se) {
		return db.Violation{}, false
	}
	return db.SQLiteViolation(se.Code(), se.Error())
}
{{else if eq .Dialect "postgres"}}
// open opens a PostgreSQL pool through pgx.
func open(dsn string) (*sql.DB, error) { return sql.Open("pgx", dsn) }

func classify(err error) (db.Violation, bool) {
	var pe *pgconn.PgError
	if !errors.As(err, &pe) {
		return db.Violation{}, false
	}
	return db.PostgresViolation(pe.Code, pe.ConstraintName)
}
{{else}}
// open opens a MySQL pool: DATETIME scans into time.Time, and one statement
// per Exec.
func open(dsn string) (*sql.DB, error) { return openMySQL(dsn, false) }

// openMigrator opens the connection migrations run on: a migration file runs
// as one Exec, so it takes several statements.
func openMigrator(dsn string) (*sql.DB, error) { return openMySQL(dsn, true) }

func openMySQL(dsn string, multi bool) (*sql.DB, error) {
	cfg, err := mysql.ParseDSN(dsn)
	if err != nil {
		return nil, err
	}
	cfg.MultiStatements, cfg.ParseTime = multi, true
	c, err := mysql.NewConnector(cfg)
	if err != nil {
		return nil, err
	}
	return sql.OpenDB(c), nil
}

func classify(err error) (db.Violation, bool) {
	var me *mysql.MySQLError
	if !errors.As(err, &me) {
		return db.Violation{}, false
	}
	return db.MySQLViolation(me.Number, me.Message)
}
{{end -}}
