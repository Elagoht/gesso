// Package api is the site's JSON API, served beside its pages.
package api

import (
	"github.com/Elagoht/gesso"
	"github.com/Elagoht/gesso/{{.Dialect}}"
)

// New is the API under basePath, keeping its records in the database at url.
func New(url, basePath string) (*gesso.App, error) {
	app, err := gesso.New(gesso.Config{
		BasePath: basePath,
		Database: {{.Dialect}}.Open(url),
		OpenAPI:  &gesso.OpenAPIConfig{Title: "{{.Name}}", Version: "0.1.0", Path: "/openapi.json", UI: "/swagger"},
	})
	if err != nil {
		return nil, err
	}
	return app, register(app)
}
