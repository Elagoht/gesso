// Command {{.Name}} serves the API. Its settings come from the environment:
//
//	ADDR          where it listens (default :8080)
//	BASE_PATH     the prefix every route is under, "/api" behind a proxy that
//	              passes the full path on (default: none)
//	DATABASE_URL  {{.DSNDoc}} (default {{.DefaultDSN}})
package main

import (
	"context"
	"log/slog"
	"os"

	"{{.Module}}/internal/app"
)

func main() {
	logger := slog.New(slog.NewJSONHandler(os.Stdout, nil))
	a, err := app.New(context.Background(), app.Config{
		Addr:     env("ADDR", ":8080"),
		BasePath: os.Getenv("BASE_PATH"),
		Database: env("DATABASE_URL", "{{.DefaultDSN}}"),
		Logger:   logger,
	})
	if err == nil {
		err = a.Run()
	}
	if err != nil {
		logger.Error("{{.Name}}", "error", err)
		os.Exit(1)
	}
}

func env(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
