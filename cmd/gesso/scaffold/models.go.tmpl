package {{.Pkg}}

import (
{{- if .UsesTime}}
	"time"
{{end}}
	"github.com/Elagoht/gesso"
{{- if .UsesDate}}
	"github.com/Elagoht/gesso/date"
{{- end}}
)

// {{.Entity}} is one of the module's records, as clients see it.
type {{.Entity}} struct {
	ID int64 `json:"id"`
{{- range .Fields}}
	{{.Go}} {{.Type}} `json:"{{.JSON}}"`
{{- end}}
}

// CreateIn is the body that creates a {{.Entity}}.
type CreateIn struct {
{{- range .Fields}}
	{{.Go}} {{.Type}} `json:"{{.JSON}}"{{if .Rule}} validate:"{{.Rule}}"{{end}}`
{{- end}}
}

// UpdateIn replaces a {{.Entity}}: its id from the path, everything else from
// the body.
type UpdateIn struct {
	ID int64 `path:"id"`
{{- range .Fields}}
	{{.Go}} {{.Type}} `json:"{{.JSON}}"{{if .Rule}} validate:"{{.Rule}}"{{end}}`
{{- end}}
}

// PatchIn changes some of a {{.Entity}}: a field left out stays as it is.
type PatchIn struct {
	ID int64 `path:"id"`
{{- range .Fields}}
	{{.Go}} gesso.Optional[{{.Type}}] `json:"{{.JSON}},omitzero" validate:"{{.Patch}}"`
{{- end}}
}

// IDIn names one {{.Entity}} by its id.
type IDIn struct {
	ID int64 `path:"id"`
}

// ListIn pages through the {{.Table}}: After is the Next of the page before.
type ListIn struct {
	After string `query:"after"`
	Take  int    `query:"take" default:"20" validate:"min=1,max=100"`
}

// The module's endpoints: the server registers them, another process calls them
// with the same types.
var (
	Create{{.Entity}} = gesso.Endpoint[CreateIn, {{.Entity}}]{Method: "POST", Pattern: "/{{.Table}}"}
	Get{{.Entity}}    = gesso.Endpoint[IDIn, {{.Entity}}]{Method: "GET", Pattern: "/{{.Table}}/{id}"}
	List{{.Plural}}   = gesso.Endpoint[ListIn, gesso.Page[{{.Entity}}]]{Method: "GET", Pattern: "/{{.Table}}"}
	Update{{.Entity}} = gesso.Endpoint[UpdateIn, {{.Entity}}]{Method: "PUT", Pattern: "/{{.Table}}/{id}"}
	Patch{{.Entity}}  = gesso.Endpoint[PatchIn, {{.Entity}}]{Method: "PATCH", Pattern: "/{{.Table}}/{id}"}
	Delete{{.Entity}} = gesso.Endpoint[IDIn, gesso.Empty]{Method: "DELETE", Pattern: "/{{.Table}}/{id}"}
)
