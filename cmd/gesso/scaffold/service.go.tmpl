package {{.Pkg}}

import "context"

// Store is what the service needs from storage, declared here, where it is used;
// a unit test hands the service a fake one.
type Store interface {
	Insert(ctx context.Context, in CreateIn) ({{.Entity}}, error)
	ByID(ctx context.Context, id int64) ({{.Entity}}, error)
	List(ctx context.Context, take, skip int) ([]{{.Entity}}, error)
	Delete(ctx context.Context, id int64) error
}

// Service is the module's business logic.
type Service struct {
	store Store
}

// NewService runs on store.
func NewService(store Store) *Service { return &Service{store: store} }

// Create adds a {{.Entity}}.
func (s *Service) Create(ctx context.Context, in CreateIn) ({{.Entity}}, error) {
	return s.store.Insert(ctx, in)
}

// Get returns a {{.Entity}}; sql.ErrNoRows reaches gesso as a 404.
func (s *Service) Get(ctx context.Context, id int64) ({{.Entity}}, error) {
	return s.store.ByID(ctx, id)
}

// List returns a page of {{.Table}}, oldest first.
func (s *Service) List(ctx context.Context, take, skip int) ([]{{.Entity}}, error) {
	return s.store.List(ctx, take, skip)
}

// Delete removes a {{.Entity}}.
func (s *Service) Delete(ctx context.Context, id int64) error {
	return s.store.Delete(ctx, id)
}
