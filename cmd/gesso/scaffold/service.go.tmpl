// Store is what the service needs; repository.gen.go is one, a test's fake another.
type Store interface {
	Insert(ctx context.Context, in models.ReqCreate{{.Entity}}) (models.{{.Entity}}, error)
	ByKey(ctx context.Context, key {{.KeyGo}}) (models.{{.Entity}}, error)
	List(ctx context.Context, in models.ReqList{{.Plural}}) (gesso.Page[models.{{.Entity}}], error)
	Update(ctx context.Context, in models.ReqUpdate{{.Entity}}) (models.{{.Entity}}, error)
	Patch(ctx context.Context, in models.ReqPatch{{.Entity}}) (models.{{.Entity}}, error)
	Delete(ctx context.Context, key {{.KeyGo}}) error
}

type Service struct {
	store Store
}

func NewService(store Store) *Service { return &Service{store: store} }

func (s *Service) Create(ctx context.Context, in models.ReqCreate{{.Entity}}) (models.{{.Entity}}, error) {
	return s.store.Insert(ctx, in)
}

func (s *Service) Get(ctx context.Context, key {{.KeyGo}}) (models.{{.Entity}}, error) {
	return s.store.ByKey(ctx, key)
}

func (s *Service) List(ctx context.Context, in models.ReqList{{.Plural}}) (gesso.Page[models.{{.Entity}}], error) {
	return s.store.List(ctx, in)
}

func (s *Service) Update(ctx context.Context, in models.ReqUpdate{{.Entity}}) (models.{{.Entity}}, error) {
	return s.store.Update(ctx, in)
}

func (s *Service) Patch(ctx context.Context, in models.ReqPatch{{.Entity}}) (models.{{.Entity}}, error) {
	return s.store.Patch(ctx, in)
}

func (s *Service) Delete(ctx context.Context, key {{.KeyGo}}) error {
	return s.store.Delete(ctx, key)
}
