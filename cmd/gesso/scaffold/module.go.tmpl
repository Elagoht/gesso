package {{.Pkg}}

import (
	"embed"

	"github.com/Elagoht/gesso"
	"github.com/Elagoht/gesso/db"
{{- if .Guard}}

	"{{.Guards}}"
{{- end}}
)

//go:embed migrations
var Migrations embed.FS

type Deps struct {
	DB db.DB
}

type Module struct {
	svc *Service
}

func New(d Deps) *Module {
	return &Module{svc: NewService(newRepository(d.DB))}
}

func (m *Module) Routes(r *gesso.Router) {
{{- if .Guard}}
	write := gesso.Guards(guards.{{.Guard}})
	Create{{.Entity}}.Handle(r, m.create, gesso.Status(201), write)
	Get{{.Entity}}.Handle(r, m.get)
	List{{.Plural}}.Handle(r, m.list)
	Update{{.Entity}}.Handle(r, m.update, write)
	Patch{{.Entity}}.Handle(r, m.patch, write)
	Delete{{.Entity}}.Handle(r, m.delete, write)
{{- else}}
	Create{{.Entity}}.Handle(r, m.create, gesso.Status(201))
	Get{{.Entity}}.Handle(r, m.get)
	List{{.Plural}}.Handle(r, m.list)
	Update{{.Entity}}.Handle(r, m.update)
	Patch{{.Entity}}.Handle(r, m.patch)
	Delete{{.Entity}}.Handle(r, m.delete)
{{- end}}
}
