// with the same types.
var (
	Create{{.Entity}} = gesso.Endpoint[models.ReqCreate{{.Entity}}, models.Res{{.Entity}}]{Method: "POST", Pattern: "/{{.Table}}"}
	Get{{.Entity}}    = gesso.Endpoint[models.Req{{.Entity}}ID, models.Res{{.Entity}}]{Method: "GET", Pattern: "/{{.Table}}/{id}"}
	List{{.Plural}}   = gesso.Endpoint[models.ReqList{{.Plural}}, gesso.Page[models.Res{{.Entity}}]]{Method: "GET", Pattern: "/{{.Table}}"}
	Update{{.Entity}} = gesso.Endpoint[models.ReqUpdate{{.Entity}}, models.Res{{.Entity}}]{Method: "PUT", Pattern: "/{{.Table}}/{id}"}
	Patch{{.Entity}}  = gesso.Endpoint[models.ReqPatch{{.Entity}}, models.Res{{.Entity}}]{Method: "PATCH", Pattern: "/{{.Table}}/{id}"}
	Delete{{.Entity}} = gesso.Endpoint[models.Req{{.Entity}}ID, gesso.Empty]{Method: "DELETE", Pattern: "/{{.Table}}/{id}"}
)
