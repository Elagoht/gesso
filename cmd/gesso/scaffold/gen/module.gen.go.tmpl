// getFile answers one of the record's files, as the record's read guard, the
// field's guard and the gate allow — or, for a public file, the gate alone.
func (m *Module) getFile(ctx context.Context, in models.Req{{.Entity}}File) (*gesso.Download, error) {
{{- if .FilesGuarded}}
	r := gesso.Request(ctx)
{{- end}}
	switch in.Field {
{{- range .Files}}
	case "{{.JSON}}":
{{- if and $m.Read (not .Public)}}
		if err := guards.{{$m.Read}}(r); err != nil {
			return nil, err
		}
{{- end}}
{{- if .Guard}}
		if err := guards.{{.Guard}}(r); err != nil {
			return nil, err
		}
{{- end}}
		e, err := m.repo.byKey(ctx, in.Key{{if $m.Gate}}, m.open(ctx){{end}})
		if err != nil {
			return nil, err
		}
		return m.serve(ctx, e.{{.Go}}, {{if eq .File "image"}}true{{else}}false{{end}})
{{- end}}
	}
	return nil, gesso.ErrNotFound
}

// serve answers the file stored under key: an image shown, any other file
// downloaded, never run as a page.
func (m *Module) serve(ctx context.Context, key string, image bool) (*gesso.Download, error) {
	if key == "" {
		return nil, gesso.ErrNotFound
	}
	body, obj, err := m.files.Open(ctx, key)
	if errors.Is(err, storage.ErrNotFound) {
		return nil, gesso.ErrNotFound
	}
	if err != nil {
		return nil, err
	}
	d := &gesso.Download{Body: body, Size: obj.Size, ModTime: obj.ModTime, Inline: image}
	switch ext := path.Ext(key); {
	case ext == ".jpg":
		d.ContentType = "image/jpeg"
	case ext == ".png":
		d.ContentType = "image/png"
	default:
		d.ContentType = mime.TypeByExtension(path.Ext(key))
		d.Filename = path.Base(key)
	}
	return d, nil
}
