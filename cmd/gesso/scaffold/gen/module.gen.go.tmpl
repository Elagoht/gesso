// ErrReorderKeys answers a reorder that does not list every record once.
var ErrReorderKeys = gesso.Unprocessable("reorder_keys", "order lists the key of every record once")
{{- end}}

type Module struct {
	app  *gesso.App
	repo *repository
{{- if .Files}}
	files storage.Storage
{{- end}}
{{- if .Auth}}
	users *auth.SQL
	auth  *auth.Module
{{- end}}
}

func New() *Module { return &Module{} }

func (m *Module) Init(app *gesso.App) error {
	if app.DB() == nil {
		return errors.New("{{.Pkg}} keeps its records in the app's Config.Database, and there is none")
	}
	m.app, m.repo = app, newRepository(app.DB())
{{- if .Files}}
	files, err := app.Storage()
	if err != nil {
		return err
	}
	m.files = files
{{- end}}
	app.Migrations(migrations)
	app.Constraints(map[string]string{ {{- range .ConstraintEntries}}"{{index . 0}}": "{{index . 1}}", {{end -}} })
{{- if .Auth}}
	m.users = auth.NewSQL(app.DB(), app.Dialect())
	m.users.Table = "{{.Table}}"
	m.auth = auth.New(auth.Options{Users: m.users})
	app.Command("users", m.users.Command(os.Stdin))
	return m.auth.Init(app)
{{- else}}
	return nil
{{- end}}
}
{{- if .Auth}}

// Users are the users who sign in, to make one from code: a seed, a test.
func (m *Module) Users() *auth.SQL { return m.users }

// Start begins sign-in's upkeep: the expired tokens removed every hour.
func (m *Module) Start(ctx context.Context) error { return m.auth.Start(ctx) }

// Stop ends it.
func (m *Module) Stop(ctx context.Context) error { return m.auth.Stop(ctx) }

// Authenticate finds who sends a request from its bearer token: the module is
// the app's sign-in.
func (m *Module) Authenticate(r *http.Request) (gesso.Identity, bool, error) {
	return m.auth.Authenticate(r)
}
{{- end}}

func (m *Module) Routes(r *gesso.Router) {
{{- if .Write}}
	write := gesso.Guards(guards.{{.Write}})
{{- end}}
{{- if .Read}}
	read := gesso.Guards(guards.{{.Read}})
{{- end}}
{{- if .Auth}}
	signedIn := gesso.Guards(gesso.RequireIdentity)
	m.auth.SignInRoutes(r)
	Me.Handle(r, m.me, signedIn)
{{- if .SelfFields}}
	UpdateMe.Handle(r, m.updateMe, signedIn{{if .SelfFiles}}, gesso.MaxBodyBytes({{.SelfFilesBodyLimit}}){{end}})
{{- end}}
{{- range .SelfFiles}}
{{- if .Routes}}
	UploadMy{{.Go}}.Handle(r, m.uploadMy{{.Go}}, signedIn, gesso.MaxBodyBytes({{.BodyLimit}}))
	DeleteMy{{.Go}}.Handle(r, m.deleteMy{{.Go}}, signedIn)
{{- end}}
{{- end}}
	Set{{.Entity}}Password.Handle(r, m.setPassword{{if .Write}}, write{{end}})
{{- end}}
	Create{{.Entity}}.Handle(r, m.create, gesso.Status(201){{if .Write}}, write{{end}}{{if .Files}}, gesso.MaxBodyBytes({{.FilesBodyLimit}}){{end}})
	Get{{.Entity}}.Handle(r, m.get{{if .Read}}, read{{end}})
	List{{.Plural}}.Handle(r, m.list{{if .Read}}, read{{end}})
	Update{{.Entity}}.Handle(r, m.update{{if .Write}}, write{{end}}{{if .Files}}, gesso.MaxBodyBytes({{.FilesBodyLimit}}){{end}})
	Patch{{.Entity}}.Handle(r, m.patch{{if .Write}}, write{{end}}{{if .Files}}, gesso.MaxBodyBytes({{.FilesBodyLimit}}){{end}})
	Delete{{.Entity}}.Handle(r, m.delete{{if .Write}}, write{{end}})
{{- if .Sortable}}
	Reorder{{.Plural}}.Handle(r, m.reorder{{if .Write}}, write{{end}})
{{- end}}
{{- if .Files}}
	// Each file's read guard is the handler's: one may be public.
	Get{{.Entity}}File.Handle(r, m.getFile)
{{- end}}
{{- range .Files}}
{{- if .Routes}}
	Upload{{$m.Entity}}{{.Go}}.Handle(r, m.upload{{.Go}}{{if $m.Write}}, write{{end}}, gesso.MaxBodyBytes({{.BodyLimit}}))
	Delete{{$m.Entity}}{{.Go}}.Handle(r, m.delete{{.Go}}{{if $m.Write}}, write{{end}})
{{- end}}
{{- end}}
{{- if .Hooks.Routes}}
	m.routes(r)
{{- end}}
}
{{- if .Guarded}}

func (m *Module) access(ctx context.Context) models.{{.Entity}}Access {
	return models.{{.Entity}}Access{ {{- range .Guarded}}{{.}}: gesso.Allowed(ctx, guards.{{.}}), {{end -}} }
}
{{- end}}
{{- if .Gate}}

// open reports whether the caller sees the records whose {{.Gate.Go}} is false.
func (m *Module) open(ctx context.Context) bool { return gesso.Allowed(ctx, guards.{{.Gate.GateGuard}}) }
{{- end}}

func (m *Module) create(ctx context.Context, in models.{{.CreateIn}}) (models.Res{{.Entity}}, error) {
{{- if .Auth}}
	data := &in.ReqCreate{{.Entity}}
{{- else}}
	data := &in
{{- end}}
{{- if .Guarded}}
	a := m.access(ctx)
	if data.Forbidden(a) {
		return models.Res{{.Entity}}{}, gesso.ErrForbidden
	}
{{- end}}
{{- if .Transformed}}
	if err := m.transform(ctx, data); err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
{{- if .Defaults}}
	m.defaults(ctx, data)
{{- end}}
	e := data.Record()
{{- if .Hooks.BeforeCreate}}
	if err := m.BeforeCreate(ctx, &e); err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
{{- if .Auth}}
	hash, err := m.users.Hash(in.Password)
	if err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
{{- if .Files}}
	keys, err := m.newFiles(ctx{{range .Files}}, data.{{.Go}}{{end}})
	if err != nil {
		return models.Res{{.Entity}}{}, err
	}
	err = db.InTx(ctx, m.app.DB(), func(tx db.DB) error {
		repo := newRepository(tx)
		var err error
		if e, err = repo.insert(ctx, e{{if .Auth}}, hash, time.Now().UnixMilli(){{end}}); err != nil {
			return err
		}
		return repo.setFiles(ctx, &e, keys)
	})
	if err != nil {
		m.discard(ctx, keys)
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
{{- if .Auth}}
{{- if not .Files}}
	e, err = m.repo.insert(ctx, e, hash, time.Now().UnixMilli())
	if err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
	if len(in.Roles) > 0 {
		if err := m.users.SetRoles(ctx, e.{{.Key.Go}}, in.Roles...); err != nil {
			return models.Res{{.Entity}}{}, err
		}
	}
	return e.Response({{.RespArgs}}), nil
{{- else if .Files}}
	return e.Response({{.RespArgs}}), nil
{{- else}}
	e, err := m.repo.insert(ctx, e)
	return e.Response({{.RespArgs}}), err
{{- end}}
}
{{- if .Transformed}}

// transform formats what was checked — {{range $i, $f := .Transformed}}{{if $i}}, {{end}}{{$f.JSON}}{{end}} — and checks it again.
func (m *Module) transform(ctx context.Context, in *models.ReqCreate{{.Entity}}) error {
{{- range .Transformed}}
{{- if or .Guard .Default}}
	if in.{{.Go}}.Set && !in.{{.Go}}.Null {
		in.{{.Go}}.Value = {{.TransformExpr (printf "in.%s.Value" .Go)}}
	}
{{- else}}
	in.{{.Go}} = {{.TransformExpr (printf "in.%s" .Go)}}
{{- end}}
{{- end}}
	if fields := validate.Struct(ctx, *in); fields != nil {
		return gesso.ErrInvalidInput.WithFields(fields...)
	}
	return nil
}

// transformPatch is transform for what a patch sets.
func (m *Module) transformPatch(ctx context.Context, in *models.ReqPatch{{.Entity}}) error {
{{- range .Transformed}}
	if in.{{.Go}}.Set && !in.{{.Go}}.Null {
		in.{{.Go}}.Value = {{.TransformExpr (printf "in.%s.Value" .Go)}}
	}
{{- end}}
	if fields := validate.Struct(ctx, *in); fields != nil {
		return gesso.ErrInvalidInput.WithFields(fields...)
	}
	return nil
}
{{- end}}
{{- if .Defaults}}

// defaults fills what a create or a PUT left out with the model's defaults.
func (m *Module) defaults(ctx context.Context, in *models.ReqCreate{{.Entity}}) {
{{- range .Defaults}}
	if !in.{{.Go}}.Set {
{{- if eq .Default "@user"}}
		if id, ok := gesso.IdentityFrom(ctx); ok {
			in.{{.Go}} = gesso.Some(id.Name)
		}
{{- else if .Nullable}}
		v := {{.DefaultValue}}
		in.{{.Go}} = gesso.Some(&v)
{{- else}}
		in.{{.Go}} = gesso.Some[{{.Type}}]({{.DefaultValue}})
{{- end}}
	}
{{- end}}
}
{{- end}}

func (m *Module) get(ctx context.Context, in models.Req{{.Entity}}Key) (models.Res{{.Entity}}, error) {
{{- if .Guarded}}
	a := m.access(ctx)
{{- end}}
	e, err := m.repo.byKey(ctx, in.Key{{if .Gate}}, m.open(ctx){{end}})
	return e.Response({{.RespArgs}}), err
}

func (m *Module) list(ctx context.Context, in models.ReqList{{.Plural}}) (gesso.Page[models.{{.ListItem}}], error) {
	page, err := m.repo.list(ctx, in{{if .Gate}}, m.open(ctx){{end}})
{{- if .Guarded}}
	a := m.access(ctx)
{{- end}}
	out := gesso.Page[models.{{.ListItem}}]{Items: make([]models.{{.ListItem}}, 0, len(page.Items)), Next: page.Next}
	for _, e := range page.Items {
		out.Items = append(out.Items, e.{{if .Listable}}Item{{else}}Response{{end}}({{.RespArgs}}))
	}
	return out, err
}

func (m *Module) update(ctx context.Context, in models.ReqUpdate{{.Entity}}) (models.Res{{.Entity}}, error) {
{{- if .Guarded}}
	a := m.access(ctx)
	if in.Forbidden(a) {
		return models.Res{{.Entity}}{}, gesso.ErrForbidden
	}
{{- end}}
{{- if .Transformed}}
	if err := m.transform(ctx, &in.ReqCreate{{.Entity}}); err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
{{- if .Defaults}}
	m.defaults(ctx, &in.ReqCreate{{.Entity}})
{{- end}}
{{- if .Guarded}}
	return m.write(ctx, in.Patch(a), a)
{{- else}}
	return m.write(ctx, in.Patch())
{{- end}}
}

func (m *Module) patch(ctx context.Context, in models.ReqPatch{{.Entity}}) (models.Res{{.Entity}}, error) {
{{- if .Guarded}}
	a := m.access(ctx)
	if in.Forbidden(a) {
		return models.Res{{.Entity}}{}, gesso.ErrForbidden
	}
{{- end}}
{{- if .Transformed}}
	if err := m.transformPatch(ctx, &in); err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
	return m.write(ctx, in{{if .Guarded}}, a{{end}})
}

func (m *Module) write(ctx context.Context, in models.ReqPatch{{.Entity}}{{if .Guarded}}, a models.{{.Entity}}Access{{end}}) (models.Res{{.Entity}}, error) {
{{- if or .Hooks.BeforeUpdate .Files}}
	old, err := m.repo.byKey(ctx, in.Key{{if .Gate}}, m.open(ctx){{end}})
	if err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- if .Files}}
	keys, err := m.newFiles(ctx{{range .Files}}, in.{{.Go}}{{end}})
	if err != nil {
		return models.Res{{.Entity}}{}, err
	}
{{- end}}
	var e models.{{.Entity}}
	err = db.InTx(ctx, m.app.DB(), func(tx db.DB) error {
		repo := newRepository(tx)
{{- if .Hooks.BeforeUpdate}}
		e = old
		in.Apply(&e)
		if err := m.BeforeUpdate(ctx, &e); err != nil {
			return err
		}
		if err := repo.save(ctx, e); err != nil {
			return err
		}
{{- else}}
		if err := repo.patch(ctx, old.ID, in); err != nil {
			return err
		}
		var err error
		if e, err = repo.byID(ctx, old.ID); err != nil {
			return err
		}
{{- end}}
{{- if .Files}}
		return repo.setFiles(ctx, &e, keys)
{{- else}}
		return nil
{{- end}}
	})
{{- if .Files}}
	if err != nil {
		m.discard(ctx, keys)
		return models.Res{{.Entity}}{}, err
	}
	m.replaced(ctx, old, keys)
	return e.Response({{.RespArgs}}), nil
{{- else}}
	return e.Response({{.RespArgs}}), err
{{- end}}
{{- else}}
	id, err := m.repo.idOf(ctx, in.Key{{if .Gate}}, m.open(ctx){{end}})
	if err != nil {
		return models.Res{{.Entity}}{}, err
	}
	if err := m.repo.patch(ctx, id, in); err != nil {
		return models.Res{{.Entity}}{}, err
	}
	e, err := m.repo.byID(ctx, id)
	return e.Response({{.RespArgs}}), err
{{- end}}
}

func (m *Module) delete(ctx context.Context, in models.Req{{.Entity}}Key) (gesso.Empty, error) {
{{- if or .Hooks.BeforeDelete .Files}}
	e, err := m.repo.byKey(ctx, in.Key{{if .Gate}}, m.open(ctx){{end}})
	if err != nil {
		return gesso.Empty{}, err
	}
{{- if .Hooks.BeforeDelete}}
	if err := m.BeforeDelete(ctx, e); err != nil {
		return gesso.Empty{}, err
	}
{{- end}}
	if err := m.repo.delete(ctx, e.ID); err != nil {
		return gesso.Empty{}, err
	}
{{- range .Files}}
	if e.{{.Go}} != "" {
		_ = m.files.Delete(ctx, e.{{.Go}})
	}
{{- end}}
	return gesso.Empty{}, nil
{{- else}}
	id, err := m.repo.idOf(ctx, in.Key{{if .Gate}}, m.open(ctx){{end}})
	if err != nil {
		return gesso.Empty{}, err
	}
	return gesso.Empty{}, m.repo.delete(ctx, id)
{{- end}}
}
{{- if .Sortable}}

func (m *Module) reorder(ctx context.Context, in models.ReqReorder{{.Plural}}) (gesso.Empty, error) {
	return gesso.Empty{}, db.InTx(ctx, m.app.DB(), func(tx db.DB) error {
		return newRepository(tx).reorder(ctx, in.Order{{if .Gate}}, m.open(ctx){{end}})
	})
}
{{- end}}
{{- range .Files}}
{{- if .Routes}}

func (m *Module) upload{{.Go}}(ctx context.Context, in models.Req{{$m.Entity}}{{.Go}}) (models.Res{{$m.Entity}}, error) {
{{- if $m.Guarded}}
	a := m.access(ctx)
{{- end}}
{{- if .Guard}}
	if !a.{{.Guard}} {
		return models.Res{{$m.Entity}}{}, gesso.ErrForbidden
	}
{{- end}}
	id, err := m.repo.idOf(ctx, in.Key{{if $m.Gate}}, m.open(ctx){{end}})
	if err != nil {
		return models.Res{{$m.Entity}}{}, err
	}
	e, err := m.store{{.Go}}(ctx, id, in.File)
	return e.Response({{$m.RespArgs}}), err
}

// store{{.Go}} keeps f as the record's {{.JSON}}: the new file first, then the
// record, then the old file goes.
func (m *Module) store{{.Go}}(ctx context.Context, id int64, f *gesso.File) (models.{{$m.Entity}}, error) {
	old, err := m.repo.byID(ctx, id)
	if err != nil {
		return old, err
	}
	key, err := m.keep{{.Go}}(ctx, f)
	if err != nil {
		return old, err
	}
	if err := m.repo.set{{.Go}}(ctx, id, key); err != nil {
		_ = m.files.Delete(ctx, key)
		return old, err
	}
	if old.{{.Go}} != "" {
		_ = m.files.Delete(ctx, old.{{.Go}})
	}
	old.{{.Go}} = key
	return old, nil
}

{{- end}}

// keep{{.Go}} checks f, {{if eq .File "image"}}writes the image again, {{end}}and stores it, answering its key.
func (m *Module) keep{{.Go}}(ctx context.Context, f *gesso.File) (string, error) {
	if f.Removed() {
		return "", gesso.ErrInvalidInput.WithFields(validate.FieldError{Field: "file", Code: "required", Message: "is required"})
	}
	src, err := f.Open()
	if err != nil {
		return "", err
	}
	defer src.Close()
{{- if eq .File "image"}}
	img, err := imaging.Process(src, imaging.Options{Width: {{.Width}}, Height: {{.Height}}, Fill: {{.Fill}}, Format: "{{.Format}}", Quality: {{.Quality}}})
	if errors.Is(err, imaging.ErrNotImage) || errors.Is(err, imaging.ErrTooLarge) {
		return "", gesso.ErrInvalidInput.WithFields(validate.FieldError{Field: "{{.JSON}}", Code: "file_type", Message: err.Error()})
	}
	if err != nil {
		return "", err
	}
	data, ext := img.Data, img.Ext
{{- else}}
	ext := ".bin"
	if exts, _ := mime.ExtensionsByType(f.ContentType); len(exts) > 0 {
		ext = exts[0]
	}
	var buf bytes.Buffer
	if _, err := buf.ReadFrom(src); err != nil {
		return "", err
	}
	data := buf.Bytes()
{{- end}}
{{- if $m.Hooks.ProcessOf .Go}}
	if data, ext, err = m.Process{{.Go}}(ctx, data, ext); err != nil {
		return "", err
	}
{{- end}}
	key := "{{$m.Table}}/{{.JSON}}-" + rand.Text() + ext
	if _, err := m.files.Put(ctx, key, bytes.NewReader(data)); err != nil {
		return "", err
	}
	return key, nil
}

{{- if .Routes}}

func (m *Module) delete{{.Go}}(ctx context.Context, in models.Req{{$m.Entity}}Key) (gesso.Empty, error) {
{{- if .Guard}}
	if !gesso.Allowed(ctx, guards.{{.Guard}}) {
		return gesso.Empty{}, gesso.ErrForbidden
	}
{{- end}}
	e, err := m.repo.byKey(ctx, in.Key{{if $m.Gate}}, m.open(ctx){{end}})
	if err != nil {
		return gesso.Empty{}, err
	}
	return gesso.Empty{}, m.drop{{.Go}}(ctx, e)
}

func (m *Module) drop{{.Go}}(ctx context.Context, e models.{{$m.Entity}}) error {
	if e.{{.Go}} == "" {
		return gesso.ErrNotFound
	}
	if err := m.repo.set{{.Go}}(ctx, e.ID, ""); err != nil {
		return err
	}
	return m.files.Delete(ctx, e.{{.Go}})
}
{{- end}}
{{- end}}
{{- if .Files}}

// fileKeys are where the files a create or a write sent are kept, "" for one
// not sent.
type fileKeys struct {
{{- range .Files}}
	{{.Go}}        string
	{{.Go}}Removed bool // the form sent it empty: the file there was goes
{{- end}}
}

// newFiles stores the files a create or a write sent, before the record is
// written: one the checks refuse stops it with nothing written.
func (m *Module) newFiles(ctx context.Context{{range .Files}}, {{.JSON}} *gesso.File{{end}}) (fileKeys, error) {
	var k fileKeys
	var err error
{{- range .Files}}
	if {{.JSON}}.Removed() {
		k.{{.Go}}Removed = true
	} else if {{.JSON}} != nil {
		if k.{{.Go}}, err = m.keep{{.Go}}(ctx, {{.JSON}}); err != nil {
			m.discard(ctx, k)
			return fileKeys{}, err
		}
	}
{{- end}}
	return k, nil
}

// discard removes files stored for a record that was not written.
func (m *Module) discard(ctx context.Context, k fileKeys) {
{{- range .Files}}
	if k.{{.Go}} != "" {
		_ = m.files.Delete(ctx, k.{{.Go}})
	}
{{- end}}
}

// replaced removes the files of old that k's took the place of.
