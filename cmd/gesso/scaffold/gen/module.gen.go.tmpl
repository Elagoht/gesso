func (m *Module) self(ctx context.Context) (models.{{.Entity}}, error) {
	id, _ := gesso.IdentityFrom(ctx)
	n, err := strconv.ParseInt(id.Subject, 10, 64)
	if err != nil {
		return models.{{.Entity}}{}, gesso.ErrInvalidToken
	}
	return m.repo.byID(ctx, n)
}
