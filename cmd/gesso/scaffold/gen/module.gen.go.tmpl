//go:embed migrations
var migrations embed.FS

var (
	Create{{.Entity}} = gesso.Endpoint[models.{{.CreateIn}}, models.Res{{.Entity}}]{Method: "POST", Pattern: "/{{.Table}}"}
	Get{{.Entity}} = gesso.Endpoint[models.Req{{.Entity}}Key, models.Res{{.Entity}}]{Method: "GET", Pattern: "/{{.Table}}/{ {{- .KeyPath -}} }"}
	List{{.Plural}} = gesso.Endpoint[models.ReqList{{.Plural}}, gesso.Page[models.{{.ListItem}}]]{Method: "GET", Pattern: "/{{.Table}}"}
	Update{{.Entity}} = gesso.Endpoint[models.ReqUpdate{{.Entity}}, models.Res{{.Entity}}]{Method: "PUT", Pattern: "/{{.Table}}/{ {{- .KeyPath -}} }"}
	Patch{{.Entity}} = gesso.Endpoint[models.ReqPatch{{.Entity}}, models.Res{{.Entity}}]{Method: "PATCH", Pattern: "/{{.Table}}/{ {{- .KeyPath -}} }"}
	Delete{{.Entity}} = gesso.Endpoint[models.Req{{.Entity}}Key, gesso.Empty]{Method: "DELETE", Pattern: "/{{.Table}}/{ {{- .KeyPath -}} }"}
{{- if .Sortable}}
	Reorder{{.Plural}} = gesso.Endpoint[models.ReqReorder{{.Plural}}, gesso.Empty]{Method: "PATCH", Pattern: "/{{.Table}}"}
{{- end}}
{{- if .Files}}
	Get{{.Entity}}File = gesso.Endpoint[models.Req{{.Entity}}File, *gesso.Download]{Method: "GET", Pattern: "/{{.Table}}/{ {{- .KeyPath -}} }/files/{field}"}
{{- end}}
{{- range .Files}}
{{- if .Routes}}
	Upload{{$m.Entity}}{{.Go}} = gesso.Endpoint[models.Req{{$m.Entity}}{{.Go}}, models.Res{{$m.Entity}}]{Method: "PUT", Pattern: "/{{$m.Table}}/{ {{- $m.KeyPath -}} }/{{.JSON}}"}
	Delete{{$m.Entity}}{{.Go}} = gesso.Endpoint[models.Req{{$m.Entity}}Key, gesso.Empty]{Method: "DELETE", Pattern: "/{{$m.Table}}/{ {{- $m.KeyPath -}} }/{{.JSON}}"}
{{- end}}
{{- end}}
{{- if .Auth}}
	Set{{.Entity}}Password = gesso.Endpoint[models.Req{{.Entity}}Password, gesso.Empty]{Method: "PUT", Pattern: "/{{.Table}}/{ {{- .KeyPath -}} }/password"}
	Me = gesso.Endpoint[gesso.Empty, models.ResMe]{Method: "GET", Pattern: "/auth/me"}
{{- if .SelfFields}}
	UpdateMe = gesso.Endpoint[models.ReqPatchMe, models.ResMe]{Method: "PATCH", Pattern: "/auth/me"}
{{- end}}
{{- range .SelfFiles}}
{{- if .Routes}}
	UploadMy{{.Go}} = gesso.Endpoint[models.ReqMy{{.Go}}, models.ResMe]{Method: "PUT", Pattern: "/auth/me/{{.JSON}}"}
	DeleteMy{{.Go}} = gesso.Endpoint[gesso.Empty, gesso.Empty]{Method: "DELETE", Pattern: "/auth/me/{{.JSON}}"}
{{- end}}
{{- end}}
{{- end}}
)
