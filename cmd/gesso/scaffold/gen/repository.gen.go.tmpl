type repository struct {
	db db.DB
}

func newRepository(d db.DB) *repository { return &repository{db: d} }

{{define "dest"}}&e.ID{{range .Fields}}, &e.{{.Go}}{{end}}{{if .Sortable}}, &position{{end}}{{end}}
func (r *repository) insert(ctx context.Context, e models.{{.Entity}}) (models.{{.Entity}}, error) {
{{- if eq $d "mysql"}}
	res, err := r.db.ExecContext(ctx, {{printf "%q" .SQL.Insert}}{{range .Fields}}, e.{{.Go}}{{end}})
	if err != nil {
		return e, err
	}
	id, err := res.LastInsertId()
	if err != nil {
		return e, err
	}
	return r.byID(ctx, id)
{{- else}}
	var id int64
	if err := r.db.QueryRowContext(ctx, {{printf "%q" .SQL.Insert}}{{range .Fields}}, e.{{.Go}}{{end}}).Scan(&id); err != nil {
		return e, err
	}
	return r.byID(ctx, id)
{{- end}}
}

func (r *repository) byKey(ctx context.Context, key {{.KeyGo}}{{if .Gate}}, open bool{{end}}) (models.{{.Entity}}, error) {
	var e models.{{.Entity}}
{{- if .Sortable}}
	var position int64
{{- end}}
	err := r.db.QueryRowContext(ctx, {{printf "%q" .SQL.ByKey}}, key{{if .Gate}}, open{{end}}).Scan({{template "dest" .}})
	return e, err
}

func (r *repository) byID(ctx context.Context, id int64) (models.{{.Entity}}, error) {
	var e models.{{.Entity}}
{{- if .Sortable}}
	var position int64
{{- end}}
	err := r.db.QueryRowContext(ctx, {{printf "%q" .SQL.ByID}}, id).Scan({{template "dest" .}})
	return e, err
}

// idOf is the id of the record at key; sql.ErrNoRows when there is none.
func (r *repository) idOf(ctx context.Context, key {{.KeyGo}}{{if .Gate}}, open bool{{end}}) (int64, error) {
	var id int64
	err := r.db.QueryRowContext(ctx, {{printf "%q" .SQL.IDOf}}, key{{if .Gate}}, open{{end}}).Scan(&id)
	return id, err
}

type cursor{{.Entity}} struct {
	Order string `json:"o,omitempty"`
	ID    int64  `json:"i"`
{{- range .Slots}}
	{{index . 0}} {{index . 1}} `json:"{{index . 0}},omitzero"`
{{- end}}
}

func (r *repository) list(ctx context.Context, in models.ReqList{{.Plural}}{{if .Gate}}, open bool{{end}}) (gesso.Page[models.{{.Entity}}], error) {
	var page gesso.Page[models.{{.Entity}}]
	after, err := gesso.DecodeCursor[cursor{{.Entity}}](in.After)
	if err != nil {
		return page, err
	}
{{- if gt (len .SQL.Lists) 1}}
	if in.After != "" && after.Order != in.Order {
		return page, gesso.BadRequest("bad_cursor", "the cursor is of another order")
	}
{{- end}}
	first := in.After == ""
	var rows *sql.Rows
	switch {{if gt (len .SQL.Lists) 1}}in.Order{{else}}""{{end}} {
{{- range .SQL.Lists}}
	case "{{.Name}}":
		rows, err = r.db.QueryContext(ctx, {{printf "%q" .SQL}},
			{{if $m.Gate}}open, {{end}}{{range $m.Filters}}in.{{.Go}} == nil, in.{{.Go}}, {{end}}first, {{if .Column}}after.{{.Slot}}, after.{{.Slot}}, {{end}}after.ID, in.Take+1)
{{- end}}
	}
	if err != nil {
		return page, err
	}
	defer rows.Close()
	page.Items = []models.{{.Entity}}{}
	var last cursor{{.Entity}}
	for rows.Next() {
		var e models.{{.Entity}}
{{- if .Sortable}}
		var position int64
{{- end}}
		if err := rows.Scan({{template "dest" $m}}); err != nil {
			return page, err
		}
		if len(page.Items) == in.Take {
			page.Next = gesso.EncodeCursor(last)
			break
		}
		page.Items = append(page.Items, e)
		last = cursor{{.Entity}}{ID: e.ID{{if gt (len .SQL.Lists) 1}}, Order: in.Order{{end}}}
		switch {{if gt (len .SQL.Lists) 1}}in.Order{{else}}""{{end}} {
{{- range .SQL.Lists}}
{{- if .Column}}
		case "{{.Name}}":
			last.{{.Slot}} = {{if .Field}}e.{{.Field.Go}}{{else}}position{{end}}
{{- end}}
{{- end}}
		}
	}
	return page, rows.Err()
}

// patch writes each field that is set and keeps the rest, in one statement.
func (r *repository) patch(ctx context.Context, id int64, in models.ReqPatch{{.Entity}}) error {
	_, err := r.db.ExecContext(ctx, {{printf "%q" .SQL.Patch}},
		{{range .Fields}}in.{{.Go}}.Set, in.{{.Go}}.Value, {{end}}id)
	return err
}

// save writes every field of e.
func (r *repository) save(ctx context.Context, e models.{{.Entity}}) error {
	_, err := r.db.ExecContext(ctx, {{printf "%q" .SQL.Save}},
		{{range .Fields}}e.{{.Go}}, {{end}}e.ID)
	return err
}

func (r *repository) delete(ctx context.Context, id int64) error {
	_, err := r.db.ExecContext(ctx, {{printf "%q" .SQL.Delete}}, id)
	return err
}
{{- if .Sortable}}

// reorder puts the records the caller sees in the order of keys, each given
// once: they take the positions they held between them, so a record the
// caller does not see keeps its place.
func (r *repository) reorder(ctx context.Context, keys []{{.KeyGo}}{{if .Gate}}, open bool{{end}}) error {
	rows, err := r.db.QueryContext(ctx, {{printf "%q" .SQL.Visible}}{{if .Gate}}, open{{end}})
	if err != nil {
		return err
	}
	ids := map[{{.KeyGo}}]int64{}
	var positions []int64
	for rows.Next() {
		var id, position int64
		var key {{.KeyGo}}
		if err := rows.Scan(&id, &key, &position); err != nil {
			_ = rows.Close()
			return err
		}
		ids[key] = id
		positions = append(positions, position)
	}
	if err := errors.Join(rows.Err(), rows.Close()); err != nil {
		return err
	}
	if len(keys) != len(ids) {
		return ErrReorderKeys
	}
	slices.Sort(positions)
	for i, key := range keys {
		id, ok := ids[key]
		if !ok {
			return ErrReorderKeys
		}
		delete(ids, key)
		if _, err := r.db.ExecContext(ctx, {{printf "%q" .SQL.SetPosition}}, positions[i], id); err != nil {
			return err
		}
	}
	return nil
}
{{- end}}
