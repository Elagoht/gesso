package models
{{if or .UsesTime .UsesDate}}
import (
{{- if .UsesTime}}
	"time"
{{end}}
{{- if .UsesDate}}
	"github.com/Elagoht/gesso/date"
{{- end}}
)
{{end}}
type Res{{.Entity}} struct {
	ID int64 `json:"id"`
{{- range .Fields}}
	{{.Go}} {{.Type}} `json:"{{.JSON}}"`
{{- end}}
}

func (e {{.Entity}}) Response() Res{{.Entity}} {
	return Res{{.Entity}}{ID: e.ID, {{range .Fields}}{{.Go}}: e.{{.Go}}, {{end}}}
}
