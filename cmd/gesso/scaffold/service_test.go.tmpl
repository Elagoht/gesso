// fakeStore keeps records in memory: the service is tested with no database.
type fakeStore struct {
	records []models.{{.Entity}}
}

func (f *fakeStore) Insert(_ context.Context, in models.ReqCreate{{.Entity}}) (models.{{.Entity}}, error) {
	e := models.{{.Entity}}{ID: int64(len(f.records) + 1){{range .Fields}}, {{.Go}}: in.{{.Go}}{{end}}}
	f.records = append(f.records, e)
	return e, nil
}

func (f *fakeStore) ByID(_ context.Context, id int64) (models.{{.Entity}}, error) {
	for _, e := range f.records {
		if e.ID == id {
			return e, nil
		}
	}
	return models.{{.Entity}}{}, sql.ErrNoRows
}

func (f *fakeStore) List(_ context.Context, afterID int64, take int) ([]models.{{.Entity}}, error) {
	out := []models.{{.Entity}}{}
	for _, e := range f.records {
		if e.ID > afterID && len(out) < take {
			out = append(out, e)
		}
	}
	return out, nil
}

func (f *fakeStore) Patch(_ context.Context, in models.ReqPatch{{.Entity}}) error {
	for i, e := range f.records {
		if e.ID != in.ID {
			continue
		}
{{- range .Fields}}
		if in.{{.Go}}.Set {
			e.{{.Go}} = in.{{.Go}}.Value
		}
{{- end}}
		f.records[i] = e
		return nil
	}
	return sql.ErrNoRows
}

func (f *fakeStore) Update(_ context.Context, in models.ReqUpdate{{.Entity}}) (models.{{.Entity}}, error) {
	for i, e := range f.records {
		if e.ID == in.ID {
			//lint:ignore S1016 field by field on purpose: a request and the stored record change apart
			f.records[i] = models.{{.Entity}}{ID: in.ID{{range .Fields}}, {{.Go}}: in.{{.Go}}{{end}}}
			return f.records[i], nil
		}
	}
	return models.{{.Entity}}{}, sql.ErrNoRows
}

func (f *fakeStore) Delete(_ context.Context, id int64) error {
	for i, e := range f.records {
		if e.ID == id {
			f.records = append(f.records[:i], f.records[i+1:]...)
			return nil
		}
	}
	return sql.ErrNoRows
}

func TestService(t *testing.T) {
	ctx := context.Background()
	svc := NewService(&fakeStore{})
	created, err := svc.Create(ctx, models.ReqCreate{{.Entity}}{})
	if err != nil {
		t.Fatal(err)
	}
	if got, err := svc.Get(ctx, created.ID); err != nil || got != created {
		t.Fatalf("got %+v %v", got, err)
	}
	second, _ := svc.Create(ctx, models.ReqCreate{{.Entity}}{})
	page, err := svc.List(ctx, "", 1)
	if err != nil || len(page.Items) != 1 || page.Items[0].ID != created.ID || page.Next == "" {
		t.Fatalf("first page: %+v %v", page, err)
	}
	if page, err = svc.List(ctx, page.Next, 1); err != nil || len(page.Items) != 1 || page.Items[0].ID != second.ID || page.Next != "" {
		t.Fatalf("last page: %+v %v", page, err)
	}
	if _, err := svc.Patch(ctx, models.ReqPatch{{.Entity}}{ID: created.ID}); err != nil {
		t.Fatalf("a patch that sets nothing: %v", err)
	}
	if _, err := svc.Patch(ctx, models.ReqPatch{{.Entity}}{ID: 999}); !errors.Is(err, sql.ErrNoRows) {
		t.Fatalf("patching a missing record: %v", err)
	}
	if _, err := svc.Update(ctx, models.ReqUpdate{{.Entity}}{ID: created.ID}); err != nil {
		t.Fatal(err)
	}
	if _, err := svc.Update(ctx, models.ReqUpdate{{.Entity}}{ID: 999}); !errors.Is(err, sql.ErrNoRows) {
		t.Fatalf("updating a missing record: %v", err)
	}
	if err := svc.Delete(ctx, created.ID); err != nil {
		t.Fatal(err)
	}
	if _, err := svc.Get(ctx, created.ID); !errors.Is(err, sql.ErrNoRows) {
		t.Fatalf("got %v", err)
	}
}
