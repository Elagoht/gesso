package {{.Pkg}}

import (
	"context"
	"database/sql"
	"errors"
	"testing"

	"github.com/Elagoht/gesso"

	"{{.Models}}"
)

// fakeStore keeps the records in memory: the service is tested with no database.
type fakeStore struct {
	records []models.{{.Entity}}
}

func (f *fakeStore) find(key {{.KeyGo}}) int {
	for i, e := range f.records {
		if e.{{.KeyField}} == key {
			return i
		}
	}
	return -1
}

func (f *fakeStore) Insert(_ context.Context, in models.ReqCreate{{.Entity}}) (models.{{.Entity}}, error) {
	e := in.Record()
	e.ID = int64(len(f.records) + 1)
	f.records = append(f.records, e)
	return e, nil
}

func (f *fakeStore) ByKey(_ context.Context, key {{.KeyGo}}) (models.{{.Entity}}, error) {
	if i := f.find(key); i >= 0 {
		return f.records[i], nil
	}
	return models.{{.Entity}}{}, sql.ErrNoRows
}

func (f *fakeStore) List(_ context.Context, in models.ReqList{{.Plural}}) (gesso.Page[models.{{.Entity}}], error) {
	return gesso.Page[models.{{.Entity}}]{Items: f.records}, nil
}

func (f *fakeStore) Update(_ context.Context, in models.ReqUpdate{{.Entity}}) (models.{{.Entity}}, error) {
	i := f.find(in.Key)
	if i < 0 {
		return models.{{.Entity}}{}, sql.ErrNoRows
	}
	e := in.Record()
	e.ID = f.records[i].ID
	f.records[i] = e
	return e, nil
}

func (f *fakeStore) Patch(_ context.Context, in models.ReqPatch{{.Entity}}) (models.{{.Entity}}, error) {
	i := f.find(in.Key)
	if i < 0 {
		return models.{{.Entity}}{}, sql.ErrNoRows
	}
	in.Apply(&f.records[i])
	return f.records[i], nil
}

func (f *fakeStore) Delete(_ context.Context, key {{.KeyGo}}) error {
	i := f.find(key)
	if i < 0 {
		return sql.ErrNoRows
	}
	f.records = append(f.records[:i], f.records[i+1:]...)
	return nil
}

func TestService(t *testing.T) {
	ctx := context.Background()
	s := NewService(&fakeStore{})
	e, err := s.Create(ctx, models.ReqCreate{{.Entity}}{ {{- .Sample -}} })
	if err != nil {
		t.Fatal(err)
	}
	if got, err := s.Get(ctx, e.{{.KeyField}}); err != nil || got.ID != e.ID {
		t.Fatalf("get: %+v %v", got, err)
	}
	if err := s.Delete(ctx, e.{{.KeyField}}); err != nil {
		t.Fatal(err)
	}
	if _, err := s.Get(ctx, e.{{.KeyField}}); !errors.Is(err, sql.ErrNoRows) {
		t.Fatalf("after delete: %v", err)
	}
}
